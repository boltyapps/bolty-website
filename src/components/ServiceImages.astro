---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const { folderPath, count, alt = "" } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,gif,webp}'
);

const resolved = await Promise.all(
  Array.from({ length: count }, async (_, i) => {
    const index = i + 1;
    const base = `/src${folderPath}/${index}`;
    const key = Object.keys(allImages).find((k) => k.startsWith(base + '.'));
    if (!key) throw new Error(`No image found for: ${base}.*`);
    return {
      src: (await allImages[key]()).default,
      alt: `${alt} ${index}`,
    };
  })
);
---

<div class="image-grid">
  {resolved.map((img) => (
    <figure class="image-grid__item">
      <Image src={img.src} alt={img.alt} loading="lazy" decoding="async" />
    </figure>
  ))}
</div>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .image-grid__item {
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-background-secondary, #f5f5f5);
  }

  .image-grid__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .image-grid__item:hover img {
    transform: scale(1.03);
  }

  /* If odd number of images, let the last one span full width */
  .image-grid__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  @media (max-width: 480px) {
    .image-grid {
      grid-template-columns: 1fr;
    }

    .image-grid__item:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
</style>