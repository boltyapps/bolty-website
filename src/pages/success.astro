---
import MasterLayout from "../layouts/MasterLayout.astro";

const pageTitle = "Submission Successful - Bolty Car Service Estimation Received";
const pageDescription = "Your estimation request has been successfully submitted to Bolty. Our team will contact you shortly to confirm your car service details.";
const pageKeywords = "submission success, estimation received, service confirmation, bolty response";
---

<MasterLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
>
  <div class="container my-5" style="margin-top: 5rem;">
    <div class="row">
      <div class="col-md-8 mx-auto">
        <div class="card card-body mt-5 shadow">
          <h3 class="fw-bold text-success">Submitted successfully</h3>
          <p class="mb-4 mt-4">Our team will contact you shortly. If you have any queries, suggestions, ideas, please reach out to us at 9963017273. Or write to support@bolty.in</p>

          <a href="https://api.whatsapp.com/send/?phone=919963017273">Click here to message us on WhatsApp.</a>
        </div>
      </div>
    </div>
  </div>
</MasterLayout>