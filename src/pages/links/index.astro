---
import MasterLayout from '../../layouts/MasterLayout.astro';
import SearchStore from "../../components/SearchStore.astro";
import { getCollection } from 'astro:content';
import StoreItem from '../../components/StoreItem.astro';

const pageTitle = "Bolty Recommended Car Products - Best Detailing & Cleaning Products";
const pageDescription = "Hand-picked car detailing, cleaning, and maintenance products recommended by Bolty experts. Premium products for denting, painting, and car care.";
const pageKeywords = "car products, detailing products, car shampoo, car cleaning, microfiber cloth, car maintenance products, recommended products";

const posts = (await getCollection('links')).sort(
	(a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()
);
---

<MasterLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  schemaMarkup={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": "https://bolty.in/links"
  }}
>
  <div class="container my-5"> 
    <div class="row"> 
      <div class="col-12"> 
        <h1 class="mb-0">Links</h1>
        <p>These are hand-picked products that we have found to be the best value for your car.</p>
        
        <div class="my-4">
          <SearchStore />
        </div>

        <div>
          {posts.map((post) => (
            <StoreItem post={post} />
          ))}
        </div>
      </div>
    </div>
  </div>
</MasterLayout>

