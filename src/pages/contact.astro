---
import MasterLayout from "../layouts/MasterLayout.astro";

const pageTitle = "Contact Bolty";
const pageDescription = "Contact Bolty for free car denting, painting and detailing service estimation. Call +91 9963017273 or chat on WhatsApp. Located in Hyderabad, Telangana.";
const pageKeywords = "contact bolty, car service inquiry, free estimation, denting painting contact, car repair contact, bolty support";
---

<MasterLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  schemaMarkup={{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "mainEntity": {
      "@type": "LocalBusiness",
      "name": "Bolty",
      "telephone": "+91 9963017273",
      "email": "support@bolty.in",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "First floor, Vasista Bhavan, Near DLF gate 3, Gachibowli",
        "addressLocality": "Hyderabad",
        "addressRegion": "Telangana",
        "postalCode": "500032",
        "addressCountry": "IN"
      }
    }
  }}
>
  <div class="container my-5" style="margin-top: 5rem;">
    <div class="row">
      <div class="col-md-8 mx-auto">
        <h1>Contact</h1>
        <div class="mt-5">
          <small>Phone</small>
          <p>+91 9963017273</p>
        </div>

        <div class="mt-3 d-flex justify-content-between">
          <div>
            <img class="me-2" src="/img/phone.png" alt="phone" width="32" />
            <a href="tel:+919963017273">Call Now</a>
          </div>
          <div>
            <img
              class="me-2"
              src="/img/whatsapp.png"
              alt="whatsapp"
              width="32"
            />
            <a href="https://wa.me/919963017273">Chat On WhatsApp</a>
          </div>
        </div>

        <div class="mt-5">
          <small>Email</small>
          <p>support@bolty.in</p>
        </div>

        <div class="mt-5">
          <small>Registered & Operations Address</small>
          <p>First floor, Vasista Bhavan, Near DLF gate 3, Gachibowli, Hyderabad, Telangana 500032.</p>
        </div>
      </div>
    </div>
  </div>
</MasterLayout>
