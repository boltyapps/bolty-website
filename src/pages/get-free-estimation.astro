---
import MasterLayout from "../layouts/MasterLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<MasterLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <script>
    fbq('track', 'Lead');
  </script>
  <div class="container my-5">
    <div class="row">
      <div class="col-12 text-center mb-3">
        <h2 class="mb-0">Get Free Estimation</h2>
      </div>

      <div class="col-md-6 mx-auto">
        <form data-netlify="true" action="/success" id="interest" method="POST" class="bg-white p-5">

          <div class="card mb-4">
          <div class="card-body bg-primary-subtle p-5">
            <h5>Download Mobile App</h5>
             <a href="https://play.google.com/store/apps/details?id=in.bolty" target="_blank"><img src="/img/playstore.webp" alt="Play Store" height="40"></a> 
             
             <a href="https://apps.apple.com/in/app/bolty/id6756659984" target="_blank"><img src="/img/appstore.png" alt="App Store" height="40"></a>
            </div>
        </div>

          <div class="bg-body-secondary p-4 mb-4 rounded">
            <img
              class="me-2"
              src="/img/whatsapp.png"
              alt="whatsapp"
              width="32"
            />
            <a href="https://wa.me/919963017273?text=Hi%2C%20I%20am%20looking%20for%20Bolty%20services">Get Free Estimation On WhatsApp</a>
          </div>

          <h4 class="fw-bold mb-4">Fill your requirement</h4>

          <div class="mb-3">
            <label for="car_name" class="form-label">Car Brand & Model</label>
            <input
              type="text"
              class="form-control"
              id="car_name"
              name="car_name"
              required
            />
          </div>
          
          <div class="mb-3">
            <label for="no_of_panels" class="form-label">No of Panels for Denting & Painting</label>
            <input
              type="text"
              class="form-control"
              id="no_of_panels"
              name="no_of_panels"
              required
            />
          </div>

          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input
              type="text"
              class="form-control"
              id="name"
              name="name"
              required
            />
          </div>

          <div class="mb-3">
            <label for="phone" class="form-label">Phone Number</label>
            <input
              type="number"
              class="form-control"
              id="phone"
              name="phone"
              required
            />
          </div>

          <button type="submit" class="btn btn-dark text-center w-100"
            >Get Free Estimation</button
          >
        </form>
      </div>
    </div>
  </div>
</MasterLayout>
